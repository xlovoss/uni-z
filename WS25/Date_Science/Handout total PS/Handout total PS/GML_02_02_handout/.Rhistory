#compare to normal
std_den = dnorm(x,mean = mean(residuals(reg)),sd = sd(residuals(reg)))
lines(x,std_den,type="l",col="red")
#as test
shapiro.test(residuals(reg))#H0: Is normal
#jarque.bera.test(residuals(reg))#same
##Autokorrelation-------------------------------------------
